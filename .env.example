# Supabase connection for SEODilated.
# Copy this file to `.env.local` and fill in the real values.
# Both values are public (anon) keys — safe for the browser because
# Row Level Security controls what they can access.
# NEVER put a service_role key in this project.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
